# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database — MongoDB Atlas free tier or local
# Local:  mongodb://localhost:27017/ai_meeting_intelligence
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/ai_meeting_intelligence
MONGODB_URI=mongodb://localhost:27017/ai_meeting_intelligence

# JWT — change these in production!
JWT_SECRET=ai_meeting_super_secret_key_2024_change_me
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=ai_meeting_refresh_secret_key_2024
JWT_REFRESH_EXPIRE=30d

# AI — OpenAI optional (app works without it using mock data)
# Get free key: https://platform.openai.com  ($5 free credit)
# Or leave as-is — mock AI will be used for transcription/summaries
OPENAI_API_KEY=sk-your-openai-api-key

# Groq — for AI Coach, Agenda Builder, Insights (free, no credit card)
# Get key: https://console.groq.com
GROQ_API_KEY=gsk-your-groq-key

# Redis — OPTIONAL (app runs fine without it)
# Only needed for background job queuing
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Email — OPTIONAL (for password reset, notifications)
# Use Gmail app password or leave blank
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@aimeetings.com
FROM_NAME=AI Meeting Intelligence

# File Storage
MAX_FILE_SIZE=500mb
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
